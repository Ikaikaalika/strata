{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokahi.local/schemas/commoncompute/lokahi-wire-v1.schema.json",
  "title": "Lokahi Common Compute wire protocol v1",
  "oneOf": [
    {"$ref": "#/$defs/start"},
    {"$ref": "#/$defs/control"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hexRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "artifact_digest", "adapter_id", "quantization"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/hexRevision"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "quantization": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 65536}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "top_p", "seed", "stop"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]},
        "stop": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_class", "context_tokens", "max_output_tokens", "batch_size"],
      "properties": {
        "workload_class": {"enum": ["interactive", "throughput", "background"]},
        "context_tokens": {"type": "integer", "minimum": 1, "maximum": 131072},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 8192},
        "batch_size": {"const": 1},
        "target_ttft_ms": {"type": "number", "exclusiveMinimum": 0},
        "min_decode_tokens_per_second": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runtime_memory_bytes", "ssd_offload"],
      "properties": {
        "max_runtime_memory_bytes": {"type": "integer", "minimum": 268435456},
        "max_resident_weight_bytes": {"type": "integer", "minimum": 1},
        "ssd_offload": {"const": "disabled"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "ttft_ms", "inter_token_latency_ms", "decode_tokens_per_second", "peak_memory_bytes", "maximum_batch_size"],
      "properties": {
        "queue_ms": {"type": "number", "minimum": 0},
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "inter_token_latency_ms": {"type": ["number", "null"], "minimum": 0},
        "decode_tokens_per_second": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "maximum_batch_size": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "route", "plan_id", "evidence_ids", "fallback_used"],
      "properties": {
        "backend": {"enum": ["mlx", "metal", "coreml", "ane", "cpu", "hybrid"]},
        "route": {"enum": ["batch_generator", "direct_single_sequence", "native_phase_program"]},
        "plan_id": {"$ref": "#/$defs/identifier"},
        "evidence_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "fallback_used": {"type": "boolean"},
        "fallback_reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "retryable", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "stage": {"enum": ["not_started", "running", "partial_output"]},
        "retryable": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "task_id", "operation", "runtime_revision", "created_at_unix_ms", "deadline_unix_ms", "model", "messages", "sampling", "objective", "memory", "deployment_mode"],
      "properties": {
        "schema_version": {"const": 1},
        "message_type": {"const": "start"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "task_id": {"$ref": "#/$defs/identifier"},
        "operation": {"const": "llm.generate"},
        "runtime_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at_unix_ms": {"type": "integer", "minimum": 0},
        "deadline_unix_ms": {"type": "integer", "minimum": 1},
        "model": {"$ref": "#/$defs/model"},
        "messages": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/chatMessage"}},
        "sampling": {"$ref": "#/$defs/sampling"},
        "objective": {"$ref": "#/$defs/objective"},
        "memory": {"$ref": "#/$defs/memory"},
        "deployment_mode": {"const": "supported"}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "control_id", "action", "issued_at_unix_ms"],
      "properties": {
        "schema_version": {"const": 1},
        "message_type": {"const": "control"},
        "control_id": {"$ref": "#/$defs/identifier"},
        "action": {"enum": ["cancel", "drain"]},
        "target_request_id": {"$ref": "#/$defs/identifier"},
        "issued_at_unix_ms": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "cancel"}}, "required": ["action"]},
          "then": {"required": ["target_request_id"]},
          "else": {"not": {"required": ["target_request_id"]}}
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "sequence", "kind", "emitted_at_unix_ms"],
      "properties": {
        "schema_version": {"const": 1},
        "message_type": {"const": "event"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "sequence": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["accepted", "progress", "text_delta", "queue_state", "warning"]},
        "emitted_at_unix_ms": {"type": "integer", "minimum": 0},
        "progress": {"type": "number", "minimum": 0, "maximum": 1},
        "text_delta": {"type": "string", "minLength": 1, "maxLength": 65536},
        "generated_tokens_delta": {"type": "integer", "minimum": 0, "maximum": 8192},
        "queue_position": {"type": "integer", "minimum": 0},
        "queue_depth": {"type": "integer", "minimum": 0},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "progress"}}, "required": ["kind"]}, "then": {"required": ["progress"]}},
        {"if": {"properties": {"kind": {"const": "text_delta"}}, "required": ["kind"]}, "then": {"required": ["text_delta", "generated_tokens_delta"]}},
        {"if": {"properties": {"kind": {"const": "queue_state"}}, "required": ["kind"]}, "then": {"required": ["queue_position", "queue_depth"]}}
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "message_type", "request_id", "terminal_sequence", "status", "finish_reason", "completed_at_unix_ms", "usage", "metrics", "execution"],
      "properties": {
        "schema_version": {"const": 1},
        "message_type": {"const": "receipt"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "terminal_sequence": {"type": "integer", "minimum": 0},
        "status": {"enum": ["completed", "failed", "cancelled", "rejected"]},
        "finish_reason": {"enum": ["stop", "length", "cancelled", "error", "rejected"]},
        "completed_at_unix_ms": {"type": "integer", "minimum": 0},
        "output_text": {"type": "string", "maxLength": 1048576},
        "usage": {"$ref": "#/$defs/usage"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "execution": {"$ref": "#/$defs/execution"},
        "failure": {"$ref": "#/$defs/failure"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {"required": ["output_text"], "not": {"required": ["failure"]}},
          "else": {"required": ["failure"]}
        }
      ]
    }
  }
}
